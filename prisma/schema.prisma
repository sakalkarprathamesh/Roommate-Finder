datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("student") // "student", "admin"
  isActive     Boolean   @default(true)
  isDemo       Boolean   @default(false)     // True for sample/test/demo accounts
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile      Profile?
  listings     Listing[] @relation("UserListings")

  sentRequests     ContactRequest[] @relation("SentRequests")
  receivedRequests ContactRequest[] @relation("ReceivedRequests")

  reportsFiled    Report[] @relation("ReporterUser")
  reportsReceived Report[] @relation("ReportedTargetUser")

  notifications Notification[]
  sentMessages  Message[]      @relation("SentMessages")
}

model Profile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  email              String   // Personal Gmail or student email
  phone              String
  school             String   // e.g. "School of Computing", "School of Design", "School of Engineering"
  department         String   // e.g. "Computer Science & Engineering", "Product Design"
  year               String   // "1st Year", "2nd Year", "3rd Year", "4th Year"
  division           String?  // Optional: "Div A", "Div B"
  studentId          String?  // Optional Student ID / Roll Number
  profilePhotoUrl    String?
  bio                String?
  emailVerified      Boolean  @default(true)
  studentVerified    Boolean  @default(false)
  verificationStatus String   @default("verified") // "pending", "verified", "rejected"
  role               String   @default("student")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Listing {
  id                String   @id @default(cuid())
  ownerId           String
  owner             User     @relation("UserListings", fields: [ownerId], references: [id], onDelete: Cascade)
  title             String
  listingType       String   // "NEED_ROOMMATE", "NEED_ACCOMMODATION", "HAVE_VACANCY", "HAVE_ROOM"
  accommodationType String   // "Hostel", "Flat", "Room", "PG", "Other"
  roomType          String   // "Private", "Shared"
  location          String   // "Near MIT-ADT", "Loni Kalbhor", "Wagholi", "Kharadi", "Manjari", "Hadapsar"
  rent              Int      // Monthly rent in ₹
  deposit           Int      @default(0) // Security deposit in ₹
  currentOccupants  Int      @default(0) // Current occupants
  vacancies         Int      @default(1) // Vacancies available
  totalCapacity     Int      @default(1) // Total capacity of room/flat
  moveInDate        String   // e.g. "September 2026", "Immediately"
  expiresAt         DateTime // Listing expiration timestamp
  description       String
  status            String   @default("ACTIVE") // "ACTIVE", "FILLED", "EXPIRED", "REMOVED", "OCCUPIED", "PENDING_CONFIRMATION"
  isDemo            Boolean  @default(false)    // True for sample/test/demo listings

  // Feature 1: Mutual Occupancy confirmation fields
  occupiedInitiatorId   String?
  occupiedPartnerId     String?
  occupiedRequestId     String?
  occupiedConfirmedAt   DateTime?
  occupiedUndoUntil     DateTime?
  occupiedConfirmedBy   String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contactRequests   ContactRequest[]
  reports           Report[]
  messages          Message[]
}

model ContactRequest {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  status     String   @default("PENDING") // "PENDING", "ACCEPTED", "REJECTED", "CANCELLED"
  message    String?

  // Feature 1: Occupancy mutual confirmation status on connection
  occupancyStatus       String?   // null | "PENDING_CONFIRMATION" | "CONFIRMED"
  occupancyInitiatorId  String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages   Message[]

  @@unique([senderId, listingId])
}

model Message {
  id               String         @id @default(cuid())
  contactRequestId String
  contactRequest   ContactRequest @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)
  listingId        String
  listing          Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User           @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content          String         // Enforces 500 word limit
  createdAt        DateTime       @default(now())

  @@index([contactRequestId])
  @@index([listingId])
  @@index([senderId])
}

model Report {
  id             String    @id @default(cuid())
  reporterId     String
  reporter       User      @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedUser   User?     @relation("ReportedTargetUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  listingId      String?
  listing        Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reason         String    // "Fake information", "Spam", "Inappropriate content", "Listing no longer available", "Other"
  description    String?
  status         String    @default("PENDING") // "PENDING", "RESOLVED", "DISMISSED"
  reviewedAt     DateTime?
  reviewedBy     String?
  createdAt      DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "REQUEST_RECEIVED", "REQUEST_ACCEPTED", "REQUEST_REJECTED", "LISTING_EXPIRING", "VERIFICATION_STATUS", "OCCUPANCY_REQUEST", "OCCUPANCY_CONFIRMED", "NEW_MESSAGE"
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
