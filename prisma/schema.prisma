datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("student") // "student", "SEEKER", "PG_OWNER", "FLAT_OWNER", "admin"
  roles        String?   @default("[\"SEEKER\"]") // JSON array for future multi-role support
  city         String?   @default("Pune")
  preferences  String?   // JSON string of flatmate preference keys
  isActive     Boolean   @default(true)
  isDemo       Boolean   @default(false)     // True for sample/test/demo accounts
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile      Profile?
  listings     Listing[] @relation("UserListings")

  sentRequests     ContactRequest[] @relation("SentRequests")
  receivedRequests ContactRequest[] @relation("ReceivedRequests")

  reportsFiled    Report[] @relation("ReporterUser")
  reportsReceived Report[] @relation("ReportedTargetUser")

  notifications Notification[]
  sentMessages  Message[]      @relation("SentMessages")
}

model Profile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  email              String   // Personal Gmail or student email
  phone              String
  school             String   // e.g. "School of Computing", "School of Design", "School of Engineering"
  department         String   // e.g. "Computer Science & Engineering", "Product Design"
  year               String   // "1st Year", "2nd Year", "3rd Year", "4th Year"
  division           String?  // Optional: "Div A", "Div B"
  studentId          String?  // Optional Student ID / Roll Number
  profilePhotoUrl    String?
  avatarId           String?  // Avatar identifier e.g. "avatar-1"
  city               String?  @default("Pune")
  bio                String?
  emailVerified      Boolean  @default(true)
  studentVerified    Boolean  @default(false)
  verificationStatus String   @default("verified") // "pending", "verified", "rejected"
  role               String   @default("student")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Listing {
  id                String   @id @default(cuid())
  ownerId           String
  owner             User     @relation("UserListings", fields: [ownerId], references: [id], onDelete: Cascade)
  title             String
  listingType       String   // "NEED_ROOMMATE", "NEED_ACCOMMODATION", "HAVE_VACANCY", "HAVE_ROOM", "PG", "FLAT"
  accommodationType String   // "Hostel", "Flat", "Room", "PG", "Other"
  roomType          String   // "Private", "Shared", "Single", "Double", "Triple"
  location          String   // "Near MIT-ADT", "Loni Kalbhor", "Wagholi", "Kharadi", "Manjari", "Hadapsar"
  address           String?  // Detailed address
  city              String?  @default("Pune")
  rent              Int      // Monthly rent in ₹ (or starting rent)
  deposit           Int      @default(0) // Security deposit / Deposit (If Any) in ₹
  currentOccupants  Int      @default(0) // Current occupants
  vacancies         Int      @default(1) // Vacancies available
  totalCapacity     Int      @default(1) // Total capacity of room/flat
  moveInDate        String   // e.g. "September 2026", "Immediately"
  expiresAt         DateTime // Listing expiration timestamp
  description       String
  status            String   @default("ACTIVE") // "ACTIVE", "FILLED", "EXPIRED", "REMOVED", "OCCUPIED", "PENDING_CONFIRMATION", "PENDING_VERIFICATION", "VERIFIED", "REJECTED"
  isDemo            Boolean  @default(false)    // True for sample/test/demo listings

  // Extended PG Owner Fields
  pgType            String?  // "Boys", "Girls", "Both"
  singleRent        Int?     // Single occupancy rent
  doubleRent        Int?     // Double occupancy rent
  tripleRent        Int?     // Triple occupancy rent
  maintenanceCharges Int?   // Maintenance charges (if any)
  noticePeriod      String?  // e.g. "1 Month", "15 Days"
  amenities         String?  // JSON array of selected amenities e.g. ["wifi", "tv", "ac"]
  photos            String?  // JSON array of photo URLs/data

  // Extended Flat Owner Fields
  bedrooms          Int?     // Number of bedrooms (e.g. 1, 2, 3)
  bathrooms         Int?     // Number of bathrooms
  furnishing        String?  // "Furnished", "Semi-Furnished", "Unfurnished"
  preferredTenant   String?  // "Students", "Boys Only", "Girls Only", "Anyone"
  availableFrom     String?  // Available from date string

  // Verification Lifecycle
  submittedAt       DateTime? @default(now())
  verifiedAt        DateTime?
  verifiedBy        String?
  rejectionReason   String?

  // Feature 1: Mutual Occupancy confirmation fields
  occupiedInitiatorId   String?
  occupiedPartnerId     String?
  occupiedRequestId     String?
  occupiedConfirmedAt   DateTime?
  occupiedUndoUntil     DateTime?
  occupiedConfirmedBy   String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contactRequests   ContactRequest[]
  reports           Report[]
  messages          Message[]
}

model ContactRequest {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  status     String   @default("PENDING") // "PENDING", "ACCEPTED", "REJECTED", "CANCELLED"
  message    String?

  // Feature 1: Occupancy mutual confirmation status on connection
  occupancyStatus       String?   // null | "PENDING_CONFIRMATION" | "CONFIRMED"
  occupancyInitiatorId  String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages   Message[]

  @@unique([senderId, listingId])
}

model Message {
  id               String         @id @default(cuid())
  contactRequestId String
  contactRequest   ContactRequest @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)
  listingId        String
  listing          Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User           @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content          String         // Enforces 500 word limit
  createdAt        DateTime       @default(now())

  @@index([contactRequestId])
  @@index([listingId])
  @@index([senderId])
}

model Report {
  id             String    @id @default(cuid())
  reporterId     String
  reporter       User      @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedUser   User?     @relation("ReportedTargetUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  listingId      String?
  listing        Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reason         String    // "Fake information", "Spam", "Inappropriate content", "Listing no longer available", "Other"
  description    String?
  status         String    @default("PENDING") // "PENDING", "RESOLVED", "DISMISSED"
  reviewedAt     DateTime?
  reviewedBy     String?
  createdAt      DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "REQUEST_RECEIVED", "REQUEST_ACCEPTED", "REQUEST_REJECTED", "LISTING_EXPIRING", "VERIFICATION_STATUS", "OCCUPANCY_REQUEST", "OCCUPANCY_CONFIRMED", "NEW_MESSAGE"
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
